{
  "name": "strada-film-discovery",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1 --port 5173",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 5173",
    "lint": "eslint app components lib scripts tests --ignore-pattern dist --ignore-pattern .next",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "benchmark:curator": "node --import tsx scripts/benchmark-curator.ts",
    "evaluate:curator-quality": "node --import tsx scripts/evaluate-curator-quality.ts",
    "score:curator-quality": "node --import tsx scripts/score-curator-quality.ts",
    "knowledge:build": "python3 scripts/build-knowledge.py --audit",
    "knowledge:embed": "node --import tsx scripts/embed-knowledge.ts",
    "knowledge:audit": "node --import tsx scripts/audit-knowledge-sources.ts",
    "knowledge:test": "python3 -m unittest discover -s research/knowledge/tests"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "parse5": "^8.0.1",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "4.2.1",
    "tsx": "^4.20.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3"
  },
  "type": "module"
}
